#--------------------------------------------------------------------

Example Environment Configuration file
CodeIgniter 4 - University Project
Copy this file to .env and adjust the values for your environment.
Never commit your real .env file or production secrets.

#--------------------------------------------------------------------

#--------------------------------------------------------------------

ENVIRONMENT

#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------

APP

#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8080/'

Uncomment and configure if required:
app.forceGlobalSecureRequests = false
app.CSPEnabled = false

#--------------------------------------------------------------------

DATABASE

#--------------------------------------------------------------------

Use the database service name defined in Docker Compose.
Replace "mysql" if your service has a different name.

database.default.hostname = mysql database.default.database = universidad database.default.username = app_user database.default.password = CHANGE_ME database.default.DBDriver = MySQLi database.default.port = 3306

Optional database settings:
database.default.DBPrefix =
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci

#--------------------------------------------------------------------

TEST DATABASE

#--------------------------------------------------------------------

Configure these values if your project uses database tests.
database.tests.hostname = mysql
database.tests.database = universidad_test
database.tests.username = app_user
database.tests.password = CHANGE_ME
database.tests.DBDriver = MySQLi
database.tests.DBPrefix =
database.tests.charset = utf8mb4
database.tests.DBCollat = utf8mb4_general_ci
database.tests.port = 3306

#--------------------------------------------------------------------

ENCRYPTION

#--------------------------------------------------------------------

Generate your own key if encryption is required.
Never publish a real encryption key.
encryption.key =

#--------------------------------------------------------------------

SESSION

#--------------------------------------------------------------------

session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.savePath = null

#--------------------------------------------------------------------

LOGGER

#--------------------------------------------------------------------

logger.threshold = 4